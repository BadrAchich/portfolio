---
import { Image } from "astro:assets";
import type { AboutProps } from "@types";
import BadgesCarousel from "./BadgesCarousel.astro";

type Props = AboutProps & { name?: string; title?: string };

const {
  description,
  image,
  name = "Badr Achich",
  headline,
  accentWord,
  subheadline,
  stats,
  skills,
  badges,
} = Astro.props;

// Default titles if not provided
const displayHeadline = headline || "INGÉNIEUR";
const displayAccent = accentWord || "RÉSEAU & CYBERSÉCURITÉ";
const displaySubheadline = subheadline || "CERTIFIÉ";

const defaultStats = [
  { value: "5+", label: "Années d'expérience & études" },
  { value: "3", label: "Certifications Cisco & Fortinet" },
  { value: "10+", label: "Projets & labs d'infrastructure" },
];

const displayStats = stats && stats.length > 0 ? stats : defaultStats;

const formatText = (text: string) => {
  return text
    .trim()
    .replace(
      /\*\*(.*?)\*\*/g,
      '<strong class="text-white font-semibold">$1</strong>'
    )
    .replace(
      /\*(.*?)\*/g,
      '<em class="text-[var(--off-white)]/70 italic">$1</em>'
    )
    .split("\n\n")
    .map(
      (paragraph) =>
        `<p class="leading-relaxed mb-4">${paragraph.trim().replace(/\n/g, "<br/>")}</p>`
    )
    .join("");
};
---

<section id="about" class="relative w-full bg-[var(--black)] py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <!-- Anchor for header navigation -->
    <div id="about-me" class="-mt-24 pt-24"></div>

    <!-- 2-Column Main Presentation Grid -->
    <div
      class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <!-- Column 1: Colossal Headline, Bio & Key Stats (7 cols) -->
      <div class="reveal flex flex-col justify-center lg:col-span-7">
        <div class="mb-4 flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--red)]"></span>
          <span
            class="font-mono text-xs tracking-widest text-[var(--off-white)]/60 uppercase"
          >
            PROFIL & VISION ARCHITECTURALE
          </span>
        </div>

        <!-- Colossal Headline in Bebas Neue -->
        <h2
          class="about-headline font-display mb-8 text-5xl leading-[0.88] tracking-tight uppercase sm:text-7xl lg:text-8xl"
        >
          <span class="block text-white">{displayHeadline}</span>
          <span class="block text-[var(--red)]">{displayAccent}</span>
          <span class="block text-white/90">{displaySubheadline}</span>
        </h2>

        <!-- Rich Formatted Bio -->
        <div
          class="font-body text-base leading-relaxed text-[var(--off-white)]/85 text-justify sm:text-left sm:text-lg"
          set:html={formatText(description)}
        />

        <!-- 3-Counter Key Statistics Grid -->
        {
          displayStats && displayStats.length > 0 && (
            <div class="mt-8 grid grid-cols-3 gap-4 border-t border-white/10 pt-8 sm:gap-6">
              {displayStats.map((stat) => (
                <div class="flex flex-col">
                  <span class="stat-num font-display mb-1 text-4xl leading-none tracking-tight text-[var(--red)] sm:text-6xl md:text-7xl">
                    {stat.value}
                  </span>
                  <span class="stat-label font-mono text-[10px] leading-tight tracking-wider text-[var(--off-white)]/60 uppercase sm:text-xs">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>
          )
        }
      </div>

      <!-- Column 2: Stylized Profile Portrait with Halo & Frame (5 cols) -->
      <div class="reveal flex items-center justify-center lg:col-span-5">
        <div class="relative w-full max-w-sm sm:max-w-md">
          <!-- Ambient Halo Glow -->
          <div
            class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-[var(--red)]/25 via-blue-600/15 to-[var(--lavender)]/25 opacity-70 blur-2xl"
          >
          </div>

          <!-- Outer Border Card -->
          <div
            class="relative aspect-square w-full overflow-hidden rounded-2xl border border-white/15 bg-black/70 p-3 shadow-2xl backdrop-blur-md"
          >
            <!-- Inner Image Container -->
            <div
              class="relative h-full w-full overflow-hidden rounded-xl border border-white/10"
            >
              <Image
                class="h-full w-full object-cover contrast-110 filter transition-all duration-700 hover:scale-105"
                src={image}
                width={500}
                height={500}
                alt={name}
              />
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
              >
              </div>

              <!-- Bottom Profile Tag -->
              <div
                class="absolute right-4 bottom-4 left-4 flex items-center justify-between border-t border-white/15 pt-2.5 font-mono text-[10px] tracking-widest text-white/80 uppercase"
              >
                <span>{name}</span>
                <span class="text-[var(--red)]">CCNA // NSE6 // DEVNET</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Technical Stack Infinite Carousel -->
    {
      skills && skills.length > 0 && (
        <div id="tech" class="mt-24 scroll-mt-24 sm:mt-32">
          <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-[var(--red)]" />
              <h3 class="font-display text-3xl tracking-wider text-white uppercase sm:text-4xl">
                Tech Stack
              </h3>
            </div>
            <span class="font-mono text-xs tracking-widest text-white/40 uppercase">
              // TECHNOLOGIES & ÉQUIPEMENTS
            </span>
          </div>
          <BadgesCarousel items={skills} direction="left" speed="normal" />
        </div>
      )
    }

    <!-- Professional Certifications Infinite Carousel -->
    {
      badges && badges.length > 0 && (
        <div id="certifications" class="mt-16 scroll-mt-24 sm:mt-24">
          <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-[var(--red)]" />
              <h3 class="font-display text-3xl tracking-wider text-white uppercase sm:text-4xl">
                Certifications
              </h3>
            </div>
            <span class="font-mono text-xs tracking-widest text-white/40 uppercase">
              // ACCRÉDITATIONS OFFICIELLES CISCO & FORTINET
            </span>
          </div>
          <BadgesCarousel items={badges} direction="right" speed="slow" />
        </div>
      )
    }
  </div>
</section>
