---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";
import BadgesCarousel from "./BadgesCarousel.astro";

type Props = AboutProps & Pick<HeroProps, "name"> & { title?: string };

const { description, image, name, title = "À propos", skills, badges } = Astro.props;

const formatText = (text: string) => {
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-medium">$1</strong>')
    .replace(/\*(.*?)\*/g, '<em class="text-neutral/80 italic">$1</em>');
};
---

<Section href="about">
  {skills && skills.length > 0 && (
    <div id="tech" class="mb-12 scroll-mt-24">
      <h3 class="mb-6 font-serif text-4xl font-bold tracking-tighter text-white">Tech Stack</h3>
      <BadgesCarousel items={skills} direction="left" speed="normal" />
    </div>
  )}

  {badges && badges.length > 0 && (
    <div id="certifications" class="mb-16 scroll-mt-24">
      <h3 class="mb-6 font-serif text-4xl font-bold tracking-tighter text-white">Certifications</h3>
      <BadgesCarousel items={badges} direction="right" speed="slow" />
    </div>
  )}

  <div id="about-me" class="scroll-mt-24">
    <h2 class="mb-8 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl">{title}</h2>
    <div class="flex flex-col-reverse items-center gap-12 md:flex-row md:gap-12 mt-4">
      <p class="w-full text-lg text-neutral/90 md:w-2/3 whitespace-pre-line leading-relaxed text-justify md:text-left" set:html={formatText(description)}></p>
      <div class="w-48 h-48 md:w-64 md:h-64 shrink-0 overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
        <Image
          class="h-full w-full object-cover"
          src={image}
          width="260"
          height="260"
          alt={name}
        />
      </div>
    </div>
  </div>
</Section>
