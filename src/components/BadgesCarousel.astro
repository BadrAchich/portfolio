---
export interface BadgeProps {
  name: string;
  image: string;
  url?: string;
}

export interface Props {
  items: BadgeProps[];
  direction?: "left" | "right";
  speed?: "fast" | "slow" | "normal";
}

const { items, direction = "left", speed = "normal" } = Astro.props;
const duration = speed === "fast" ? "15s" : speed === "slow" ? "35s" : "25s";
---

<div class="scroller my-8">
  <ul
    class="scroller-inner m-0 list-none flex gap-6 p-0 items-center"
    data-direction={direction}
    style={`--animation-duration: ${duration};`}
  >
    {
      [...items, ...items, ...items].map((badge) => (
        <li class="flex-shrink-0">
          <a 
            href={badge.url || "#"} 
            target={badge.url ? "_blank" : "_self"} 
            rel="noopener noreferrer"
            class="block w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden bg-white/5 border-2 border-transparent transition-all hover:border-primary hover:scale-105 hover:shadow-[0_0_15px_rgba(var(--color-primary),0.3)]"
            title={badge.name}
          >
            <img 
              src={badge.image} 
              alt={badge.name} 
              class="w-full h-full object-cover" 
              loading="lazy"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .scroller {
    overflow: hidden;
    /* Soft fade effect on the left and right edges */
    -webkit-mask: linear-gradient(
      90deg,
      transparent,
      white 15%,
      white 85%,
      transparent
    );
    mask: linear-gradient(
      90deg,
      transparent,
      white 15%,
      white 85%,
      transparent
    );
  }

  .scroller-inner {
    width: max-content;
    flex-wrap: nowrap;
    animation: scroll var(--animation-duration) linear infinite;
  }

  .scroller-inner[data-direction="right"] {
    animation-direction: reverse;
  }

  .scroller-inner:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    to {
      transform: translate(calc(-33.333333% - 0.5rem));
    }
  }
</style>
