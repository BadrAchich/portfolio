---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-white/10 bg-[var(--black)] px-6 py-8 text-[var(--off-white)] md:px-12"
>
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 md:flex-row"
  >
    <!-- Left Column: Copyright in Space Mono -->
    <div
      class="text-center font-mono text-xs text-[var(--off-white)]/60 md:text-left"
    >
      <span>© {currentYear} {author.toUpperCase()}. TOUS DROITS RÉSERVÉS.</span>
    </div>

    <!-- Center Column: Monogram Logo -->
    <div class="flex items-center justify-center">
      <a
        href="#hero"
        class="group flex items-center gap-1 font-display text-2xl font-bold tracking-[0.25em] text-[var(--off-white)] transition-colors hover:text-[var(--red)]"
        aria-label="Retour au sommet"
      >
        <span>BXDR</span>
        <span
          class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--red)] transition-transform group-hover:scale-125"
        ></span>
      </a>
    </div>

    <!-- Right Column: Social Links in Space Mono -->
    <nav
      class="flex items-center justify-center gap-6 font-mono text-xs tracking-wider md:justify-end"
      aria-label="Social Links"
    >
      {
        socialLinks.map(({ text, href }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="relative py-1 text-[var(--off-white)]/70 transition-colors after:absolute after:bottom-0 after:left-0 after:h-[1px] after:w-0 after:bg-[var(--red)] after:transition-all hover:text-white hover:after:w-full"
          >
            <span>{text}</span>
            <span class="ml-0.5 text-[var(--red)]">↗</span>
          </a>
        ))
      }
    </nav>
  </div>
</footer>
