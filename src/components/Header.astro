---
import type { HeaderProps } from "@types";

type Props = HeaderProps;

const { navLinks } = Astro.props;
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-12 md:py-5">
    <!-- Left Column: Stylized Hamburger + MENU in Space Mono -->
    <div class="flex items-center">
      <button
        type="button"
        id="menu-toggle-btn"
        class="group flex items-center gap-2.5 font-mono text-xs tracking-widest uppercase text-[var(--off-white)] transition-colors hover:text-[var(--red)] focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="flex h-3.5 w-4 flex-col justify-between">
          <span class="h-[1.5px] w-4 bg-current transition-all duration-300"></span>
          <span class="h-[1.5px] w-2.5 bg-current transition-all duration-300 group-hover:w-4"></span>
          <span class="h-[1.5px] w-4 bg-current transition-all duration-300"></span>
        </span>
        <span class="hidden font-mono text-xs tracking-widest sm:inline">MENU</span>
      </button>
    </div>

    <!-- Center Column: Monogram Logo in Bebas Neue -->
    <div class="flex items-center justify-center">
      <a
        href="/"
        class="group flex items-center gap-1 font-display text-2xl font-bold tracking-[0.25em] text-[var(--off-white)] transition-colors hover:text-[var(--red)] md:text-3xl"
        aria-label="Badr Achich Portfolio"
      >
        <span>BXDR</span>
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--red)] transition-transform group-hover:scale-125"></span>
      </a>
    </div>

    <!-- Right Column: Navigation Links + Language in Space Mono -->
    <div class="flex items-center justify-end">
      <nav class="hidden items-center gap-6 font-mono text-xs tracking-wider lg:flex" aria-label="Main Navigation">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="header-nav-link relative py-1 text-[var(--off-white)]/70 transition-colors hover:text-[var(--off-white)] after:absolute after:bottom-0 after:left-0 after:h-[1px] after:w-0 after:bg-[var(--red)] after:transition-all hover:after:w-full"
            >
              {link.text}
            </a>
          ))
        }
      </nav>

      <!-- Compact view for mobile right slot (shows language button if available) -->
      <div class="lg:hidden">
        {
          (() => {
            const langLink = navLinks.find(
              (l) => l.href.startsWith("/") || l.text.includes("EN") || l.text.includes("FR")
            );
            return langLink ? (
              <a
                href={langLink.href}
                class="font-mono text-xs tracking-wider text-[var(--off-white)]/80 transition-colors hover:text-[var(--red)]"
              >
                {langLink.text}
              </a>
            ) : null;
          })()
        }
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-[60] flex -translate-y-4 flex-col justify-between bg-[#0a0a0a]/95 px-6 py-8 opacity-0 pointer-events-none backdrop-blur-2xl transition-all duration-300 md:hidden"
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between border-b border-white/10 pb-6">
    <a href="/" class="font-display text-2xl font-bold tracking-[0.2em] text-[var(--off-white)]">
      BXDR<span class="text-[var(--red)]">.</span>
    </a>
    <button
      type="button"
      id="menu-close-btn"
      class="font-mono text-xs tracking-widest text-[var(--off-white)]/80 transition-colors hover:text-[var(--red)]"
      aria-label="Fermer le menu"
    >
      [FERMER ✕]
    </button>
  </div>

  <!-- Drawer Links List -->
  <ul class="my-auto flex flex-col gap-4 py-6">
    {
      navLinks.map((link, idx) => (
        <li>
          <a
            href={link.href}
            class="mobile-drawer-link flex items-center justify-between border-b border-white/5 py-3 font-display text-3xl uppercase tracking-wider text-[var(--off-white)] transition-colors hover:text-[var(--red)]"
          >
            <span>{link.text}</span>
            <span class="font-mono text-xs tracking-widest text-white/30">
              {String(idx + 1).padStart(2, "0")}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Drawer Footer -->
  <div class="flex items-center justify-between border-t border-white/10 pt-6 font-mono text-[10px] tracking-wider text-white/40">
    <span>BADR ACHICH</span>
    <span>INGÉNIEUR CYBER & RÉSEAUX</span>
    <span>2026</span>
  </div>
</div>

<style>
  #main-header.scrolled {
    background-color: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  #mobile-drawer.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  // Header scroll blur trigger
  const header = document.getElementById("main-header");
  const handleScroll = () => {
    if (window.scrollY > 40) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }
  };
  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  // Mobile drawer interaction
  const toggleBtn = document.getElementById("menu-toggle-btn");
  const closeBtn = document.getElementById("menu-close-btn");
  const drawer = document.getElementById("mobile-drawer");
  const drawerLinks = document.querySelectorAll(".mobile-drawer-link");

  const openDrawer = () => {
    drawer?.classList.add("open");
    drawer?.setAttribute("aria-hidden", "false");
    toggleBtn?.setAttribute("aria-expanded", "true");
    document.body.classList.add("overflow-hidden");
  };

  const closeDrawer = () => {
    drawer?.classList.remove("open");
    drawer?.setAttribute("aria-hidden", "true");
    toggleBtn?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("overflow-hidden");
  };

  toggleBtn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  drawerLinks.forEach((link) => {
    link.addEventListener("click", closeDrawer);
  });

  // Highlight active nav item on scroll
  const navLinks = document.querySelectorAll(".header-nav-link");
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === `#${entry.target.id}`) {
              link.classList.add("text-white", "after:w-full");
              link.classList.remove("text-[var(--off-white)]/70");
            } else if (href && href.startsWith("#")) {
              link.classList.remove("text-white", "after:w-full");
              link.classList.add("text-[var(--off-white)]/70");
            }
          });
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll("section[id]").forEach((section) => {
    sectionObserver.observe(section);
  });
</script>
