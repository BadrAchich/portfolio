---
import type { HeroProps } from "@types";

type Props = Partial<HeroProps> & {
  contactText?: string;
  downloadCvText?: string;
};

const {
  name = "Badr Achich",
  specialty = "Ingénieur Réseau et Cybersécurité",
  summary = "",
  email = "badr.achich.contact@gmail.com",
  tagline = "Sécuriser, automatiser, bâtir.",
  label = "Badr Achich · Ingénieur Réseaux & Cybersécurité · 2026",
  ctaText = "EXPLORER / CV",
  cvLink = "/cv.pdf",
} = Astro.props;
---

<section
  id="hero"
  class="relative flex min-h-screen w-full flex-col items-center justify-center px-4 pt-24 pb-16 sm:px-6 md:px-8"
>
  <!-- Screen reader accessible context -->
  <div class="sr-only">
    <h1>{name}</h1>
    <h2>{specialty}</h2>
    <p>{summary}</p>
    <a href={`mailto:${email}`}>{email}</a>
  </div>

  <!-- Hero Torn Frame Media Canvas -->
  <div
    class="hero-media torn-frame reveal relative mx-auto flex aspect-[4/3] w-full max-w-5xl min-h-[380px] sm:min-h-[440px] md:min-h-[500px] md:aspect-[16/9] items-center justify-center overflow-hidden border border-white/5 bg-[#0a0a0a] shadow-2xl"
  >
    <!-- Background Gradient Layer -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_#16192b_0%,_#0d0e17_50%,_#050508_100%)]"
    >
    </div>

    <!-- Cybersecurity Technical Grid Pattern -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(rgba(255,255,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.2) 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>

    <!-- Glowing Animated Ambient Orbs -->
    <div
      class="hero-orb-1 absolute -top-12 -left-12 h-64 w-64 rounded-full bg-[var(--red)]/20 blur-[75px] sm:h-80 sm:w-80 sm:blur-[90px]"
      style="--tx: 35px; --ty: -25px;"
    >
    </div>
    <div
      class="hero-orb-2 absolute -bottom-16 -right-16 h-72 w-72 rounded-full bg-[var(--lavender)]/15 blur-[85px] sm:h-96 sm:w-96 sm:blur-[100px]"
      style="--tx: -30px; --ty: 30px;"
    >
    </div>
    <div
      class="hero-orb-3 absolute top-1/2 left-1/2 h-80 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/10 blur-[90px]"
      style="--tx: 20px; --ty: -30px;"
    >
    </div>

    <!-- Floating Particles Layer -->
    <div class="hero-particles pointer-events-none absolute inset-0">
      <span
        class="particle absolute top-[20%] left-[18%] h-1.5 w-1.5 rounded-full bg-white/70 shadow-[0_0_8px_white]"
        style="--tx: 15px; --ty: -25px; animation-duration: 5s;"
      ></span>
      <span
        class="particle absolute top-[35%] right-[22%] h-2 w-2 rounded-full bg-[var(--red)]/80 shadow-[0_0_10px_var(--red)]"
        style="--tx: -20px; --ty: 20px; animation-duration: 7s; animation-delay: 1s;"
      ></span>
      <span
        class="particle absolute bottom-[28%] left-[26%] h-1 w-1 rounded-full bg-white/60 shadow-[0_0_6px_white]"
        style="--tx: 25px; --ty: -15px; animation-duration: 6s; animation-delay: 2s;"
      ></span>
      <span
        class="particle absolute top-[68%] right-[32%] h-1.5 w-1.5 rounded-full bg-[var(--lavender)]/70 shadow-[0_0_8px_var(--lavender)]"
        style="--tx: -15px; --ty: -20px; animation-duration: 8s; animation-delay: 0.5s;"
      ></span>
      <span
        class="particle absolute top-[14%] right-[40%] h-1 w-1 rounded-full bg-white/50"
        style="--tx: 10px; --ty: 15px; animation-duration: 5.5s; animation-delay: 1.5s;"
      ></span>
    </div>

    <!-- Top Status Indicator Pill -->
    <div class="absolute top-5 right-5 sm:top-7 sm:right-7 z-20">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/50 px-3 py-1 font-mono text-[10px] tracking-widest text-[var(--off-white)]/60 uppercase backdrop-blur-md"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>SYSTEM SECURE // 2026</span>
      </div>
    </div>

    <!-- Central Interactive CTA Button with Pulsing Waves -->
    <div class="relative z-20 flex items-center justify-center">
      <a
        href={cvLink || "#projects"}
        target={cvLink ? "_blank" : "_self"}
        rel="noopener noreferrer"
        class="group relative flex h-32 w-32 sm:h-40 sm:w-40 items-center justify-center focus:outline-none"
        aria-label={ctaText}
      >
        <!-- Concentric Pulsing Wave Rings -->
        <span
          class="pulse-ring absolute inset-0 rounded-full border border-[var(--red)] pointer-events-none"
        ></span>
        <span
          class="pulse-ring-delayed absolute -inset-3 rounded-full border border-[var(--red)]/40 pointer-events-none"
        ></span>

        <!-- Main Button Disc -->
        <div
          class="relative flex h-full w-full flex-col items-center justify-center rounded-full border border-white/20 bg-black/80 p-4 text-center shadow-2xl backdrop-blur-md transition-all duration-300 group-hover:scale-105 group-hover:border-[var(--red)] group-hover:bg-[var(--red)]/15 group-hover:shadow-[0_0_35px_rgba(232,40,30,0.4)]"
        >
          <!-- Stylized Arrow or Compass Icon -->
          <svg
            class="mb-1 h-5 w-5 sm:h-6 sm:w-6 text-[var(--red)] transition-transform duration-300 group-hover:translate-y-0.5 group-hover:scale-110"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>

          <!-- Button Text in Bebas Neue & Space Mono -->
          <span
            class="font-display text-lg tracking-[0.2em] text-white transition-colors group-hover:text-[var(--red)] sm:text-xl"
          >
            {ctaText}
          </span>
          <span
            class="font-mono text-[9px] tracking-widest text-[var(--off-white)]/50 uppercase group-hover:text-white/80"
          >
            ACCÉDER
          </span>
        </div>
      </a>
    </div>

    <!-- Bottom Left Label Tag -->
    <div class="absolute bottom-5 left-5 sm:bottom-7 sm:left-7 z-20">
      <div
        class="inline-flex max-w-[85vw] sm:max-w-none items-center gap-2 rounded-full border border-white/10 bg-black/60 px-3.5 py-1.5 font-mono text-[10px] tracking-wider text-[var(--off-white)]/85 backdrop-blur-md sm:text-xs"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--red)]"></span>
        <span class="truncate">{label}</span>
      </div>
    </div>
  </div>

  <!-- Tagline underneath the frame in Permanent Marker -->
  <div class="mt-8 text-center reveal sm:mt-10 md:mt-12">
    <p
      class="font-hand text-2xl tracking-wide text-[var(--cream)] select-none -rotate-1 sm:text-3xl md:text-5xl"
    >
      “{tagline}”
    </p>
  </div>
</section>

<style>
  .hero-orb-1 {
    animation: orbFloat 10s ease-in-out infinite alternate;
  }
  .hero-orb-2 {
    animation: orbFloat 14s ease-in-out infinite alternate;
    animation-delay: -5s;
  }
  .hero-orb-3 {
    animation: orbFloat 12s ease-in-out infinite alternate;
    animation-delay: -3s;
  }

  .particle {
    animation: float 6s ease-in-out infinite alternate;
    will-change: transform;
  }

  .pulse-ring {
    animation: pulseRing 2.4s cubic-bezier(0.2, 0.8, 0.4, 1) infinite;
  }

  .pulse-ring-delayed {
    animation: pulseRing 2.4s cubic-bezier(0.2, 0.8, 0.4, 1) infinite;
    animation-delay: 1.2s;
  }
</style>
