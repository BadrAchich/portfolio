---
import type { HeroProps } from "@types";
type Props = HeroProps & { contactText?: string; downloadCvText?: string; cvLink?: string };

const { 
  name, 
  specialty, 
  summary, 
  email, 
  contactText = "Me contacter",
  downloadCvText = "Télécharger CV",
  cvLink = "/cv.pdf"
} = Astro.props;
---

<section class="py-24 md:py-32" id="#hero">
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-11.5 font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {specialty}
  </p>
  <p class="mb-16 text-base font-normal text-neutral md:text-lg">
    {summary}
  </p>

  <div class="flex flex-wrap gap-4">
    <a
      class="inline-block rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff] transition-opacity hover:opacity-90"
      href="https://www.linkedin.com/in/badr-achich-166595248/"
      target="_blank"
      rel="noopener noreferrer"
    >
      {contactText}
    </a>
    <a
      class="inline-block rounded-full border border-white/20 bg-transparent px-8 py-5 text-sm leading-5 font-medium text-white transition-colors hover:bg-white/10"
      href={cvLink}
      target="_blank"
      rel="noopener noreferrer"
    >
      {downloadCvText}
    </a>
  </div>
</section>
