---
import type { TickerItem } from "../types";

export interface Props {
  items: TickerItem[];
}

const { items = [] } = Astro.props;

// Duplicate items to ensure a seamless infinite -50% translateX translation
const trackItems = [...items, ...items];
---

<div class="ticker-container w-full overflow-hidden bg-[var(--cream)] text-[var(--black)] border-y border-black/10 py-3.5 select-none relative z-20">
  <div class="ticker-track flex w-max items-center hover:[animation-play-state:paused]">
    {trackItems.map((item) => (
      <div class="ticker-entry flex items-center gap-3.5 px-8 whitespace-nowrap">
        <span class="font-display text-2xl md:text-3xl tracking-wider uppercase font-bold text-[var(--black)]">
          {item.word}
        </span>
        <span class="font-mono text-[11px] md:text-xs tracking-widest text-[var(--black)]/65 uppercase">
          {item.pos} {item.phon}
        </span>
        <span class="font-body text-xs md:text-sm italic font-medium text-[var(--black)]/85">
          — {item.def}
        </span>
        <span class="ml-6 text-xs text-[var(--red)]" aria-hidden="true">✦</span>
      </div>
    ))}
  </div>
</div>

<style>
  .ticker-track {
    animation: ticker 32s linear infinite;
    will-change: transform;
  }
</style>
