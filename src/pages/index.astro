---
import { SITE_CONTENT, SITE_CONFIG } from "../config/fr";
import Hero from "@components/Hero.astro";
import Ticker from "@components/Ticker.astro";
import Projects from "@components/Projects.astro";
import About from "@components/About.astro";
import Expertise from "@components/Expertise.astro";
import Experience from "@components/Experience.astro";
import Contact from "@components/Contact.astro";
import Layout from "@layouts/Layout.astro";

import "../styles/global.css";
---

<Layout config={SITE_CONFIG}>
  <Hero {...SITE_CONTENT.hero} />
  <Ticker items={SITE_CONTENT.ticker} />
  <Projects projects={SITE_CONTENT.projects} />
  <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
  <Expertise items={SITE_CONTENT.expertise} />
  <Experience experience={SITE_CONTENT.experience} />
  <Contact {...SITE_CONTENT.contact} />
</Layout>
